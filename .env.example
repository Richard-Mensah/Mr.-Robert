# ─────────────────────────────────────────────────────────────
# Robert Kampi Laari website: environment variables
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Database (Neon Postgres) ─────────────────────────────────
# Neon console → your project → Connection Details → "Pooled connection".
# Must include ?sslmode=require. Leave empty to run without a database
# (forms will show "not available yet" and Insights shows "coming soon").
DATABASE_URL=""

# ── Admin inbox (/admin) ─────────────────────────────────────
# HTTP Basic Auth for the private inbox of inquiries, subscribers and
# Leadership Compass results. The password must be at least 12 characters.
# Leave either empty to disable /admin entirely.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# ── Site ─────────────────────────────────────────────────────
# Public URL, no trailing slash. Used for canonical URLs, the sitemap,
# Open Graph images and structured data. Change it to the live domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Google Search Console ────────────────────────────────────
# The content value from the "HTML tag" verification method, e.g. "abc123…".
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
